# Production Environment Variables
# Copy this file to .env.production and fill in real values

# NextAuth.js
# NEXTAUTH_URL must be the app subdomain, NOT the apex domain — the app
# and all /auth/* and /api/auth/* routes live on app.timelyplan.me, while
# timelyplan.me itself only redirects visitors there (see src/middleware.ts).
NEXTAUTH_SECRET=generate-a-secure-random-string-here
NEXTAUTH_URL=https://app.timelyplan.me

# Public domains and host-based dashboard routing
TIMELY_MARKETING_HOST=timelyplan.me
TIMELY_APP_HOST=app.timelyplan.me
TIMELY_APP_ORIGIN=https://app.timelyplan.me
NEXT_PUBLIC_APP_URL=https://app.timelyplan.me

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# PostgreSQL Database (recommended for production)
DATABASE_URL=postgresql://user:password@host:port/database

# Django Backend API URL (Northflank deployment)
NEXT_PUBLIC_API_URL=https://your-backend-service.code.run
# BACKEND_URL takes priority over NEXT_PUBLIC_API_URL when both are set

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# Nutrition photo analysis (auto: Groq -> OpenRouter -> Gemini)
NUTRITION_PHOTO_PROVIDER=auto
GROQ_API_KEY=your-groq-api-key
NUTRITION_GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
OPENROUTER_API_KEY=your-openrouter-api-key

# Do NOT set NEXT_PUBLIC_DEV_BYPASS_AUTH in production — it disables all
# auth checks in src/middleware.ts and is only meant for local development.

# IMPORTANT:
# 1. Replace all placeholder values with real credentials
# 2. In Google Cloud Console, add authorized redirect URI:
#    https://app.timelyplan.me/api/auth/callback/google
# 3. Never commit this file with real values to git
