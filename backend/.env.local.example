# Локальные переопределения backend. Скопируй в `.env.local` — он не коммитится.
#
# Смысл файла один: чтобы `manage.py migrate`, набранный без флагов, не уходил
# в боевую базу. В корневом `.env` лежит production-овый DATABASE_URL, и он
# нужен там для фронтенда и скриптов; здесь он перебивается локальным.
#
# Загружается в `config/settings.py` ПОСЛЕ корневого `.env` и с override=True.

DATABASE_URL=sqlite:///./db.sqlite3

# По умолчанию DEBUG выключен, чтобы прод не мог включить его случайно. Локально
# он нужен, в том числе чтобы браузер с localhost:3000 пропускали по CORS.
DEBUG=True

# Тот же, что у Next.js в корневом `.env.local`: без него backend не стартует.
# Сгенерировать: openssl rand -hex 32
TIMELY_API_JWT_SECRET=
