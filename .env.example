# NextAuth.js Configuration
NEXTAUTH_SECRET=your-nextauth-secret-here-min-32-characters
NEXTAUTH_URL=http://localhost:3000

# Public domains and host-based dashboard routing
TIMELY_MARKETING_HOST=timelyplan.me
TIMELY_APP_HOST=app.timelyplan.me
TIMELY_APP_ORIGIN=https://app.timelyplan.me
NEXT_PUBLIC_APP_URL=https://app.timelyplan.me

# Google OAuth (create at https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Django Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Gemini AI (optional, for AI features)
GEMINI_API_KEY=your-gemini-api-key

# Nutrition photo analysis (auto: Groq -> OpenRouter -> Gemini)
NUTRITION_PHOTO_PROVIDER=auto
GROQ_API_KEY=your-groq-api-key
NUTRITION_GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
OPENROUTER_API_KEY=your-openrouter-api-key

# ─── Chat / whiteboard LLM (REQUIRED in any cloud deployment) ────────────────
# This is the model behind /api/ai/chat, /api/ai/solve and /api/ai/draw — i.e.
# the AI Tutor itself. If BOARD_LLM_BASE_URL is left unset, the code falls back
# to settings.QWEN_API_BASE_URL, which points at a Mac Studio on a private
# Tailscale address (100.64.0.0/10). That address is unreachable from a cloud
# container, so every chat request hangs until the 60s router timeout and the
# user sees "Модель не ответила вовремя" — which looks exactly like a dead
# model even though the model is fine. This already happened in production.
# Always set these three explicitly on Vercel/Northflank.
BOARD_LLM_BASE_URL=https://openrouter.ai/api/v1
BOARD_LLM_API_KEY=your-openrouter-api-key
BOARD_LLM_MODEL=z-ai/glm-4.6v
# Set to true only for local development against the Mac Studio; when false
# (the default outside DEBUG) the server logs a loud error if the URL is unset.
AI_ALLOW_LOCAL_LLM_FALLBACK=false

# Whiteboard OCR and Smart Canvas Analyzer (ai_engine.glm_client).
# VISION_API_KEY is optional: it falls back to OPENROUTER_API_KEY above.
# Point VISION_API_BASE_URL/VISION_MODEL_NAME at a local OpenAI-compatible
# server (e.g. http://<host>:8081/v1) to go back to a self-hosted OCR model.
VISION_API_BASE_URL=https://openrouter.ai/api/v1
VISION_MODEL_NAME=qwen/qwen3-vl-32b-instruct
VISION_TIMEOUT=60
# Otsu thresholding before OCR. Off by default — it was tuned for a dedicated
# OCR model and a general VLM usually reads the un-thresholded image better.
VISION_OCR_BINARIZE=0

# Adaptive lesson intake. Uses the existing OpenRouter key and text client.
PLANNING_MODEL=deepseek/deepseek-v4-flash
PLANNING_ENABLED=true
PLANNING_MAX_QUESTIONS=4
PLANNING_REASONING_ENABLED=true
PLANNING_TIMEOUT=20

# Scientific illustration A/B pipeline (legacy is the safe production default)
DIAGRAM_PIPELINE_MODE=legacy
DIAGRAM_PLANNER_MODEL=qwen/qwen3.7-plus
DIAGRAM_CRITIC_MODEL=qwen/qwen3.7-plus
# seedream-4.5 удалена с OpenRouter (404) — не возвращать без проверки
# доступности в /api/v1/models.
IMAGE_GEN_MODEL=google/gemini-3-pro-image
DIAGRAM_PLANNER_ENABLED=true
DIAGRAM_CRITIC_ENABLED=true
DIAGRAM_MAX_RETRIES=1

# AI usage ledger and Timely-token limits
# Pro keeps the former global limits. Max defaults to 20x Pro usage.
AI_FREE_CONTEXT_TOKEN_LIMIT=32000
AI_FREE_TOKEN_5H_LIMIT=25000
AI_FREE_TOKEN_WEEKLY_LIMIT=100000
AI_CONTEXT_TOKEN_LIMIT=128000
AI_TOKEN_5H_LIMIT=250000
AI_TOKEN_WEEKLY_LIMIT=1000000
AI_MAX_CONTEXT_TOKEN_LIMIT=256000
AI_MAX_TOKEN_5H_LIMIT=5000000
AI_MAX_TOKEN_WEEKLY_LIMIT=20000000
AI_PRO_PRICE_USD=19.9
AI_MAX_PRICE_USD=199
AI_IMAGE_TOKEN_CHARGE=4000
AI_USAGE_ENFORCE_LIMITS=true

# ── Curriculum: эмбеддинги фрагментов книги (Фаза 7) ──────────────────────────
# У OpenRouter эндпоинт /embeddings ЕСТЬ и совместим с OpenAI SDK, поэтому
# отдельный ключ не нужен: EMBEDDING_API_KEY по умолчанию берётся из
# OPENROUTER_API_KEY.
#
# ВАЖНО: эмбеддинг-моделей нет в каталоге /api/v1/models — проверять их наличие
# надо запросом к самому /embeddings, иначе легко решить, что их не существует.
#
# Размерность 1536 зашита в миграцию 0003 как vector(1536), и модели отличаются:
# openai/text-embedding-3-small — 1536, baai/bge-m3 — 1024,
# qwen/qwen3-embedding-8b — 4096. Смена модели на другую размерность требует
# новой миграции и переиндексации всех чанков.
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
# Задавать только если эмбеддинги считает НЕ тот провайдер, что чат-модели.
EMBEDDING_API_KEY=
# Потолок числа фрагментов одной книги. Не ради экономии (учебник на 400 страниц
# стоит ~$0.004), а чтобы ограничить патологический документ.
CURRICULUM_MAX_EMBEDDED_CHUNKS=4000

# ── Curriculum: хранилище исходных PDF (Фаза 4a) ──────────────────────────────
# Переключатель ровно один — непустой бакет. Пусто = локальная папка, которая
# годится только для тестов и одиночной dev-машины: контейнер эфемерный, и
# загруженный учебник пропадает при перезапуске.
#
# Для Cloudflare R2: ENDPOINT_URL вида https://<account>.r2.cloudflarestorage.com,
# REGION=auto, а SSE оставить ПУСТЫМ — заголовок ServerSideEncryption R2 не
# принимает, и с ним каждая загрузка отвечала бы ошибкой.
# Общий рубильник. Под тест-раннером выключается автоматически, чтобы боевые
# ключи из .env не утекли в прогон тестов и не залили мусор в настоящий бакет.
CURRICULUM_S3_ENABLED=true
CURRICULUM_S3_BUCKET=
CURRICULUM_S3_REGION=
CURRICULUM_S3_ENDPOINT_URL=
# Ключи необязательны: в облаке их может выдавать роль инстанса.
CURRICULUM_S3_ACCESS_KEY_ID=
CURRICULUM_S3_SECRET_ACCESS_KEY=
CURRICULUM_S3_SIGNED_URL_TTL=300
CURRICULUM_S3_SSE=

# ── Curriculum: очередь обработки (Фаза 4b) ───────────────────────────────────
# Пусто = обработка идёт внутри HTTP-запроса (режим inline). Это работающий
# дефолт: забытая переменная не должна приводить к документу, навсегда зависшему
# в статусе «загружен».
#
# Redis-аддон Northflank отдаёт схему rediss:// (TLS) в переменной
# REDIS_MASTER_URL — она подхватывается автоматически. Для rediss:// настройки
# сами добавляют ssl_cert_reqs: без него kombu падает при СТАРТЕ воркера, а не
# на первой задаче.
CELERY_BROKER_URL=
# Northflank называет её так же — настройки читают оба имени.
REDIS_MASTER_URL=
# Потолок на одну книгу. Мягкий лимит на минуту раньше жёсткого, чтобы задача
# успела записать причину остановки в IngestionJob.
CELERY_TASK_TIME_LIMIT=3600
CELERY_TASK_SOFT_TIME_LIMIT=3540
# Воркер поднимается из ТОГО ЖЕ образа: миграции запускает только web-контейнер.
RUN_MIGRATIONS=1


# ── Curriculum: размер фрагментов книги (Фаза 5) ──────────────────────────────
# Считает настоящий токенайзер cl100k_base, а не «символы делить на четыре»: на
# кириллице эвристика недосчитывает почти вдвое.
# TARGET — где стараемся закрыть фрагмент, MAX — граница при добавлении блока,
# OVERLAP — сколько токенов предыдущего фрагмента повторяется в начале
# следующего (только внутри прозы одного раздела, никогда через задачу/решение).
CHUNK_TARGET_TOKENS=500
CHUNK_MAX_TOKENS=650
CHUNK_OVERLAP_TOKENS=75
